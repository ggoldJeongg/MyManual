<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- =========================
         COLORS
    ========================== -->
    <Color x:Key="Color.Primary">#00A878</Color>
    <Color x:Key="Color.PrimaryDark">#02996e</Color>
	<Color x:Key="Color.PrimaryLight">#E6F4EA</Color>

	<Color x:Key="Color.Secondary">#1E5AA8</Color>
	<Color x:Key="Color.SecondaryDark">#174B8A</Color>
	<Color x:Key="Color.SecondaryLight">#E8F0FB</Color>

	<Color x:Key="Color.Background">#F5F7F8</Color>
	<Color x:Key="Color.Surface">#FFFFFF</Color>

	<Color x:Key="Color.Border">#E5E7EB</Color>
	<Color x:Key="Color.Disabled">#D1D5DB</Color>

	<Color x:Key="Color.TextPrimary">#111827</Color>
	<Color x:Key="Color.TextSecondary">#6B7280</Color>
	<Color x:Key="Color.TextOnPrimary">#FFFFFF</Color>

	<!-- Optional semantic colors -->
	<Color x:Key="Color.Error">#D92D20</Color>
	<Color x:Key="Color.Warning">#F79009</Color>

	<!-- =========================
         BRUSHES
    ========================== -->
	<SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
	<SolidColorBrush x:Key="Brush.PrimaryDark" Color="{StaticResource Color.PrimaryDark}" />
	<SolidColorBrush x:Key="Brush.PrimaryLight" Color="{StaticResource Color.PrimaryLight}" />

	<SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}" />
	<SolidColorBrush x:Key="Brush.SecondaryDark" Color="{StaticResource Color.SecondaryDark}" />
	<SolidColorBrush x:Key="Brush.SecondaryLight" Color="{StaticResource Color.SecondaryLight}" />

	<SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
	<SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />

	<SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
	<SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}" />

	<SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
	<SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
	<SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource Color.TextOnPrimary}" />

	<SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
	<SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />

	<!-- Hover overlays (호버 오버레이) -->
	<SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryDark}" Opacity="0.10" />
	<SolidColorBrush x:Key="Brush.SecondaryHover" Color="{StaticResource Color.SecondaryDark}" Opacity="0.10" />

	<!-- =========================
         TYPOGRAPHY / SPACING / SHAPE
    ========================== -->
	<FontFamily x:Key="Font.Default">Segoe UI</FontFamily>

	<!-- Font sizes -->
	<System:Double x:Key="FontSize.H1" xmlns:System="clr-namespace:System;assembly=mscorlib">22</System:Double>
	<System:Double x:Key="FontSize.H2" xmlns:System="clr-namespace:System;assembly=mscorlib">18</System:Double>
	<System:Double x:Key="FontSize.Body" xmlns:System="clr-namespace:System;assembly=mscorlib">14</System:Double>
	<System:Double x:Key="FontSize.Caption" xmlns:System="clr-namespace:System;assembly=mscorlib">12</System:Double>

	<!-- Spacing -->
	<Thickness x:Key="Space.XS">4</Thickness>
	<Thickness x:Key="Space.S">8</Thickness>
	<Thickness x:Key="Space.M">12</Thickness>
	<Thickness x:Key="Space.L">16</Thickness>
	<Thickness x:Key="Space.XL">24</Thickness>

	<!-- Corner radius -->
	<CornerRadius x:Key="Radius.S">6</CornerRadius>
	<CornerRadius x:Key="Radius.M">10</CornerRadius>
	<CornerRadius x:Key="Radius.L">14</CornerRadius>

	<!-- Control heights -->
	<System:Double x:Key="ControlHeight.Input" xmlns:System="clr-namespace:System;assembly=mscorlib">36</System:Double>
	<System:Double x:Key="ControlHeight.Button" xmlns:System="clr-namespace:System;assembly=mscorlib">38</System:Double>

</ResourceDictionary>
