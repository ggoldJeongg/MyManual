<UserControl x:Class="MyManual.Views.ManualCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700" MinHeight="600"
             Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 로고 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Polygon Points="15,0 30,26 0,26" Fill="#00A878" Margin="0,0,10,0"/>
                    <TextBlock Text="MyManual" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 메뉴 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Button Content="매뉴얼"
                            Padding="15,8" Margin="0,0,10,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="#666"
                            Click="OnManualButtonClick"
                            Cursor="Hand"/>
                    <Button Content="온보딩"
                            Padding="15,8"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="#666"
                            Click="OnOnboardingButtonClick"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- 사용자 이름 -->
                <TextBlock Grid.Column="2" Text="{Binding CurrentUserName}"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- 메인 폼 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Padding="40,30" MaxWidth="900" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 업무명 + 카테고리 (같은 줄) -->
                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 업무명 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="업무명" FontSize="14" FontWeight="Bold" Foreground="#00A878" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,12"
                                     FontSize="14"
                                     Height="42"
                                     VerticalContentAlignment="Top"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- 카테고리 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="카테고리" FontSize="14" FontWeight="Bold" Foreground="#00A878" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Padding="8,8"
                                      FontSize="14"
                                      Height="42"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- 업무 목적 -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,25">
                        <TextBlock Text="업무 목적" FontSize="14" FontWeight="Bold" Foreground="#00A878" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 Padding="12"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- 프로세스 -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,25">
                        <TextBlock Text="프로세스" FontSize="14" FontWeight="Bold" Foreground="#00A878" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Process, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 Padding="12"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- 히스토리 -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,30">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="히스토리" FontSize="14" FontWeight="Bold" Foreground="#00A878"/>
                            <TextBlock Text="  (선택)" FontSize="11" Foreground="#999" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Background="White">
                            <Grid>
                                <!-- 날짜 표시 영역 -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="#F0FAF7" Padding="8,6" Margin="8,8,0,0" CornerRadius="3">
                                    <TextBlock Text="📅 오늘" FontSize="11" Foreground="#00A878"/>
                                </Border>

                                <!-- 입력 영역 -->
                                <TextBox Text="{Binding History, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="80"
                                         Padding="12,36,12,12"
                                         FontSize="14"
                                         BorderThickness="0"
                                         Background="Transparent"
                                        VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="💡 생성 시 오늘 날짜가 자동으로 기록됩니다. 비워두면 '매뉴얼 생성됨'으로 저장됩니다."
                                   FontSize="11" Foreground="#999" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- 버튼들 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- 제출하기 버튼 -->
                        <Button Content="{Binding SubmitButtonText}"
                                Command="{Binding SubmitCommand}"
                                Padding="30,12"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                Margin="0,0,20,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#00A878"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#008F5F"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#C0C0C0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 취소하기 버튼 -->
                        <Button Content="취소하기"
                                Command="{Binding CancelCommand}"
                                Padding="30,12"
                                FontSize="14"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
