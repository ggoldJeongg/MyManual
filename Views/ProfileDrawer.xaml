<UserControl x:Class="MyManual.Views.ProfileDrawer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- 배경 오버레이 (클릭 시 닫기) -->
        <Border x:Name="Overlay" Background="#40000000" Opacity="0" Visibility="Collapsed"
                MouseLeftButtonDown="OnOverlayClick"/>

        <!-- Drawer 패널 -->
        <Border x:Name="DrawerPanel"
                Width="320"
                HorizontalAlignment="Right"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTransform" X="320"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="프로필" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0"
                                FontSize="14" Cursor="Hand" Padding="8,4"
                                Foreground="#999"
                                Click="OnCloseClick"/>
                    </Grid>
                </Border>

                <!-- 스크롤 가능한 콘텐츠 영역 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 프로필 정보 -->
                        <StackPanel Margin="20">
                            <!-- 프로필 아바타 -->
                            <Border Width="80" Height="80" CornerRadius="40"
                                    Background="#00A878" Margin="0,0,0,15"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="AvatarText"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- 이름 -->
                            <TextBlock x:Name="UserNameText"
                                       FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>

                            <!-- 입사일 -->
                            <TextBlock x:Name="JoinDateText"
                                       FontSize="13" Foreground="#666"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>

                            <!-- 역할 뱃지 -->
                            <Border x:Name="RoleBadge" HorizontalAlignment="Center"
                                    Padding="12,6" CornerRadius="12" Margin="0,0,0,10">
                                <TextBlock x:Name="RoleText" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- 구분선 -->
                        <Border Height="1" Background="#E0E0E0"/>

                        <!-- 관리자 전용: 사용자 목록 -->
                        <StackPanel x:Name="AdminSection" Visibility="Collapsed">
                            <!-- 섹션 헤더 -->
                            <Border Padding="20,15" Background="#FAFAFA">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="전체 사용자" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                        <TextBlock x:Name="UserCountText" FontSize="12" Foreground="#666"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button Content="새로고침" HorizontalAlignment="Right"
                                            Click="OnRefreshUsersClick"
                                            Cursor="Hand"
                                            Padding="8,4"
                                            FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Foreground" Value="#00A878"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F0FAF7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 사용자 목록 -->
                            <ItemsControl x:Name="UserListControl" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="20,12" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 아바타 -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                        Background="{Binding AvatarBackground}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding AvatarInitial}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{Binding AvatarForeground}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- 사용자 정보 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                                                    <TextBlock Text="{Binding JoinDateText}" FontSize="11" Foreground="#999"/>
                                                </StackPanel>

                                                <!-- 관리자 토글 버튼 (자기 자신이 아닌 경우에만 표시) -->
                                                <Button Grid.Column="2" VerticalAlignment="Center"
                                                        Click="OnToggleAdminClick"
                                                        Tag="{Binding}"
                                                        Cursor="Hand"
                                                        Visibility="{Binding CanToggleAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="{Binding RoleBadgeBackground}"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="10,5"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                Padding="{TemplateBinding Padding}"
                                                                                CornerRadius="8">
                                                                            <TextBlock Text="{Binding RoleText}" FontSize="10"
                                                                                       Foreground="{Binding RoleBadgeForeground}"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 로그아웃 버튼 -->
                <Border Grid.Row="2" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Button Content="로그아웃"
                            Padding="15,12"
                            FontSize="14"
                            Foreground="White"
                            Cursor="Hand"
                            Click="OnLogoutClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#DC3545"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C82333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
