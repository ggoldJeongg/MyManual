<UserControl x:Class="MyManual.Views.ProfileDrawer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- 배경 오버레이 (클릭 시 닫기) -->
        <Border x:Name="Overlay" Background="#40000000" Opacity="0" Visibility="Collapsed"
                MouseLeftButtonDown="OnOverlayClick"/>

        <!-- Drawer 패널 -->
        <Border x:Name="DrawerPanel"
                Width="300"
                HorizontalAlignment="Right"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTransform" X="300"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="프로필" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="X" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0"
                                FontSize="16" Cursor="Hand" Padding="8,4"
                                Click="OnCloseClick"/>
                    </Grid>
                </Border>

                <!-- 프로필 정보 -->
                <StackPanel Grid.Row="1" Margin="20">
                    <!-- 프로필 아바타 -->
                    <Border Width="80" Height="80" CornerRadius="40"
                            Background="#00A878" Margin="0,0,0,15"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="AvatarText"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- 이름 -->
                    <TextBlock x:Name="UserNameText"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>

                    <!-- 입사일 -->
                    <TextBlock x:Name="JoinDateText"
                               FontSize="13" Foreground="#666"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- 구분선 -->
                    <Border Height="1" Background="#E0E0E0" Margin="0,0,0,20"/>

                    <!-- 추가 정보 -->
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="역할" FontSize="13" Foreground="#666"/>
                            <TextBlock x:Name="RoleText"
                                       HorizontalAlignment="Right"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- 로그아웃 버튼 -->
                <Border Grid.Row="2" Padding="20">
                    <Button Content="로그아웃"
                            Padding="15,12"
                            FontSize="14"
                            Foreground="White"
                            Cursor="Hand"
                            Click="OnLogoutClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#DC3545"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C82333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
