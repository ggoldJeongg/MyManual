<UserControl x:Class="MyManual.Views.UserInitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MyManual.Converters"
             MinWidth="400" MinHeight="600"
             Background="#F5F5F5">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- 중앙 카드 -->
        <Border Background="White"
                CornerRadius="10"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="350"
                MaxWidth="400"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <!-- 로고 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Polygon Points="15,0 30,26 0,26" Fill="#00A878" Margin="0,0,10,0"/>
                    <TextBlock Text="MyManual"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="#333"/>
                </StackPanel>

                <!-- 모드 전환 탭 -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="로그인"
                            Command="{Binding SwitchToLoginCommand}"
                            Padding="10,8" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5,0,0,5"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderBrush="#E0E0E0" BorderThickness="1,1,0,1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoginMode}" Value="True">
                                        <Setter Property="Background" Value="#00A878"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="회원가입"
                            Command="{Binding SwitchToRegisterCommand}"
                            Padding="10,8" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="0,5,5,0"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderBrush="#E0E0E0" BorderThickness="0,1,1,1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoginMode}" Value="False">
                                        <Setter Property="Background" Value="#00A878"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 이름 입력 -->
                <TextBlock Text="이름"
                           FontSize="12"
                           Foreground="#666"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12"
                         FontSize="14"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"
                         Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- 입사일 입력 (회원가입 모드에서만 표시) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="입사일"
                               FontSize="12"
                               Foreground="#666"
                               Margin="0,0,0,8"/>
                    <DatePicker SelectedDate="{Binding JoinDate, UpdateSourceTrigger=PropertyChanged}"
                                Padding="8"
                                FontSize="14"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Margin="0,0,0,15">
                    </DatePicker>
                </StackPanel>

                <!-- 비밀번호 입력 -->
                <TextBlock Text="비밀번호"
                           FontSize="12"
                           Foreground="#666"
                           Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox"
                             Padding="8"
                             FontSize="14"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             Margin="0,0,0,15"
                             PasswordChanged="PasswordBox_PasswordChanged">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- 비밀번호 확인 (회원가입 모드에서만 표시) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="비밀번호 확인"
                               FontSize="12"
                               Foreground="#666"
                               Margin="0,0,0,8"/>
                    <PasswordBox x:Name="PasswordConfirmBox"
                                 Padding="8"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Margin="0,0,0,20"
                                 PasswordChanged="PasswordConfirmBox_PasswordChanged">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>
                </StackPanel>

                <!-- 안내 메시지 (회원가입 모드) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,15">
                    <TextBlock Text="한 번 등록하면 수정할 수 없습니다."
                               FontSize="12"
                               Foreground="#888"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 에러 메시지 -->
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="Red"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- 제출 버튼 -->
                <Button Content="{Binding SubmitButtonText}"
                        Command="{Binding SubmitCommand}"
                        Padding="15,12"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#00A878"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#008F5F"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#C0C0C0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
