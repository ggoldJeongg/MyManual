<UserControl x:Class="MyManual.Views.OnboardingView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyManual.Converters"
        xmlns:views="clr-namespace:MyManual.Views"
        MinWidth="600" MinHeight="400">
    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:DayToColorConverter x:Key="DayToColorConverter"/>
        <converters:DayToTextColorConverter x:Key="DayToTextColorConverter"/>
    </UserControl.Resources>
    <Grid Background="#F5F5F5">
        <!-- 메인 콘텐츠 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <views:Header x:Name="HeaderControl" Grid.Row="0" ActiveMenu="Onboarding"
                          ManualClick="OnManualButtonClick"
                          CategoryClick="OnCategoryButtonClick"
                          UserNameClick="OnUserNameClick"/>

            <!-- 메인 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border Padding="20,20">
            <StackPanel>

                <!-- 주차 표시 및 입사일 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding WeekText}"
                               FontSize="14" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Grid.Column="1" Text="{Binding JoinDateText}"
                               FontSize="12" Foreground="#666"/>
                </Grid>

                <!-- 주차별 Day 버튼 리스트 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 이전 주 버튼 -->
                    <Button Grid.Column="0" Content="◀"
                            Command="{Binding PreviousWeekCommand}"
                            Padding="10,8" Margin="0,0,10,0"
                            Background="#E0E0E0" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand"
                            IsEnabled="{Binding CanGoPreviousWeek}"/>

                    <!-- Day 버튼들 (동적, 균등 분배) -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayText}"
                                        Command="{Binding DataContext.SelectDayCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Day}"
                                        Margin="4,0" Padding="10,10"
                                        BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                        IsEnabled="{Binding IsEnabled}"
                                        HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#C8C8C8"/>
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Background" Value="#00962D"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrentDay}" Value="True">
                                                    <Setter Property="Background" Value="#007A25"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 다음 주 버튼 -->
                    <Button Grid.Column="2" Content="▶"
                            Command="{Binding NextWeekCommand}"
                            Padding="10,8" Margin="10,0,0,0"
                            Background="#E0E0E0" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand"
                            IsEnabled="{Binding CanGoNextWeek}"/>
                </Grid>

                <!-- 현재 보고 있는 Day 표시 -->
                <Border Background="#00A878" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                    <TextBlock Text="{Binding CurrentDayText}"
                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                </Border>

                <!-- 진행률 -->
                <Border Background="White" CornerRadius="5" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressText}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ProgressBar Height="12" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100">
                            <ProgressBar.Foreground>
                                <SolidColorBrush Color="#00A878"/>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </StackPanel>
                </Border>

                <!-- 안내 메시지 -->
                <TextBlock Text="첫 입문을 환영합니다! 아래 체크리스트를 완료하고 매뉴얼을 확인하세요." 
                           FontSize="14" Margin="0,0,0,20" TextWrapping="Wrap"
                           Foreground="#333"/>

                <!-- 작업 목록 -->
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 체크박스 -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,15,0"
                                              Command="{Binding DataContext.ToggleTaskCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Width" Value="24"/>
                                                <Setter Property="Height" Value="24"/>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <!-- 제목 (클릭 가능) -->
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="14">
                                        <Hyperlink Command="{Binding DataContext.OpenManualCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   TextDecorations="None">
                                            <TextBlock Text="{Binding Title}"/>
                                        </Hyperlink>
                                    </TextBlock>

                                    <!-- 상태 표시 -->
                                    <Border Grid.Column="2" 
                                            Background="{Binding IsCompleted, Converter={StaticResource BoolToColorConverter}}"
                                            CornerRadius="4" 
                                            Padding="12,6">
                                        <TextBlock Text="{Binding StatusText}" 
                                                   Foreground="White" 
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
            </Border>
        </ScrollViewer>
        </Grid>

        <!-- 프로필 Drawer (오버레이) -->
        <views:ProfileDrawer x:Name="ProfileDrawer" LogoutRequested="OnLogoutRequested"/>
    </Grid>
</UserControl>