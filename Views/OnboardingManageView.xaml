<UserControl x:Class="MyManual.Views.OnboardingManageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyManual.Views"
        xmlns:vm="clr-namespace:MyManual.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <views:Header x:Name="HeaderControl" Grid.Row="0" ActiveMenu="OnboardingManage"/>

        <!-- 프로필 Drawer (최상단 레이어) -->
        <views:ProfileDrawer x:Name="ProfileDrawer" Grid.Row="0" Grid.RowSpan="2"
                             Panel.ZIndex="1000"/>

        <!-- 메인 콘텐츠 -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 신입사원 목록 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,15,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 목록 헤더 -->
                    <Border Grid.Row="0" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="신입사원 목록" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock Text="{Binding EmployeeCountText}" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 사용자 목록 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Employees}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="15,12"
                                            BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 아바타 -->
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                    Background="#E8F5E9" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding AvatarInitial}"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="#43A047"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 사용자 정보 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                                <TextBlock Text="{Binding JoinDateText}" FontSize="11" Foreground="#999"/>
                                            </StackPanel>

                                            <!-- 진행률 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                                           Foreground="#00A878" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                                             Width="50" Height="4" Margin="0,4,0,0"
                                                             Foreground="#00A878" Background="#E0E0E0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 오른쪽: 할일 분배 패널 -->
            <Border Grid.Column="1" Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <!-- 사용자 미선택 상태 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEmployee}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="사용자를 선택하세요" FontSize="16" Foreground="#999"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="왼쪽 목록에서 신입사원을 선택하면 할일 분배가 가능합니다."
                                   FontSize="13" Foreground="#BBB" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 사용자 선택 상태 -->
                    <Grid Visibility="{Binding HasSelectedEmployee, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 선택된 사용자 정보 헤더 -->
                        <Border Grid.Row="0" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="45" Height="45" CornerRadius="22"
                                            Background="#00A878" Margin="0,0,15,0">
                                        <TextBlock Text="{Binding SelectedEmployeeAvatar}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedEmployeeName}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                        <TextBlock Text="{Binding SelectedEmployeeProgress}" FontSize="13" Foreground="#666"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 초기화 버튼 -->
                                <Button Grid.Column="1" Content="전체 초기화"
                                        Command="{Binding ResetAllTasksCommand}"
                                        Padding="15,8"
                                        Background="#FF5722" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 콘텐츠 영역: 현재 할일 + 매뉴얼 분배 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 왼쪽: 현재 할당된 할일 목록 -->
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 섹션 헤더 -->
                                    <Border Grid.Row="0" Background="#F8F9FA" Padding="15,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <TextBlock Text="현재 할당된 할일" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                    </Border>

                                    <!-- 할일 목록 (Day별) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15"
                                                  Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding DayTaskGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,15">
                                                        <StackPanel>
                                                            <!-- Day 헤더 -->
                                                            <Border Background="#E8F5E9" Padding="10,6" CornerRadius="4" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32">
                                                                        <Run Text="Day "/>
                                                                        <Run Text="{Binding Day}"/>
                                                                    </TextBlock>
                                                                    <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#666">
                                                                        <Run Text="{Binding CompletedCount}"/>
                                                                        <Run Text="/"/>
                                                                        <Run Text="{Binding TotalCount}"/>
                                                                        <Run Text=" 완료"/>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>

                                                            <!-- 태스크 목록 -->
                                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Padding="10,8" Margin="0,0,0,4"
                                                                                Background="#FAFAFA" CornerRadius="4"
                                                                                BorderBrush="#E8E8E8" BorderThickness="1">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- 태스크 제목 -->
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="{Binding Title}"
                                                                                           VerticalAlignment="Center"
                                                                                           FontSize="12"
                                                                                           TextTrimming="CharacterEllipsis">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="#999"/>
                                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                                                                                                    <Setter Property="Foreground" Value="#333"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>

                                                                                <!-- 삭제 버튼 -->
                                                                                <Button Grid.Column="1" Content="✕"
                                                                                        Width="24" Height="24"
                                                                                        FontSize="10"
                                                                                        Background="Transparent"
                                                                                        Foreground="#999"
                                                                                        BorderThickness="0"
                                                                                        Cursor="Hand"
                                                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                        CommandParameter="{Binding TaskId}"
                                                                                        ToolTip="삭제"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 할일 없음 메시지 -->
                                    <TextBlock Grid.Row="1"
                                               Text="할당된 할일이 없습니다."
                                               FontSize="13" Foreground="#999"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- 오른쪽: 매뉴얼 분배 -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 섹션 헤더 -->
                                <Border Grid.Row="0" Background="#F8F9FA" Padding="15,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="매뉴얼 분배" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                </Border>

                                <!-- 매뉴얼 목록 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15">
                                    <ItemsControl ItemsSource="{Binding Manuals}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10" Margin="0,0,0,8"
                                                        CornerRadius="6"
                                                        Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectManualCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FAFAFA"/>
                                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                                    <Setter Property="BorderBrush" Value="#2196F3"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#666" Margin="0,3,0,0"/>
                                                        </StackPanel>

                                                        <!-- 선택 표시 -->
                                                        <TextBlock Grid.Column="1" Text="✓" FontSize="16" FontWeight="Bold"
                                                                   Foreground="#2196F3" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 분배 컨트롤 -->
                                <Border Grid.Row="2" Background="#F8F9FA" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Day 선택 -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Day" FontSize="13" FontWeight="SemiBold" Foreground="#333"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox Width="70" Height="32"
                                                      FontSize="13" VerticalContentAlignment="Center"
                                                      ItemsSource="{Binding AvailableDays}"
                                                      SelectedItem="{Binding SelectedDay}">
                                                <ComboBox.Resources>
                                                    <Style TargetType="Popup">
                                                        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 빈 공간 (레이아웃 유지) -->
                                        <Border Grid.Column="1"/>

                                        <!-- 분배 버튼 -->
                                        <Button Grid.Column="2" Content="분배하기"
                                                Command="{Binding AssignManualCommand}"
                                                Padding="20,8"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#BDBDBD"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanAssign}" Value="True">
                                                            <Setter Property="Background" Value="#00A878"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
