<UserControl x:Class="MyManual.Views.ManualView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="700" MinHeight="500">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 로고 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="30" Height="30" Fill="#00A878" Margin="0,0,10,0"/>
                    <TextBlock Text="MyManual" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 메뉴 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="온보딩"
                            Padding="15,8" Margin="0,0,10,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="#666"
                            Click="OnOnboardingButtonClick"
                            Cursor="Hand"/>
                    <Button Content="매뉴얼"
                            Padding="15,8" Margin="0,0,10,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Foreground="#00A878"
                            Cursor="Hand"/>
                    <Button Content="카테고리"
                            Padding="15,8"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14" Foreground="#666"
                            Click="OnCategoryButtonClick"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- 검색 + 매뉴얼 입력 버튼 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox Width="200" Padding="10,8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,15,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Content="+ 매뉴얼 입력"
                            Click="OnManualCreateButtonClick"
                            Padding="15,8"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#00A878"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#008F5F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 메인 콘텐츠 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="350"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 매뉴얼 목록 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 카테고리 필터 -->
                    <Border Grid.Row="0" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="카테고리" FontWeight="Bold" FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Padding="10,8"
                                      BorderBrush="#E0E0E0"
                                      HorizontalAlignment="Stretch"
                                      MaxDropDownHeight="200"/>
                        </StackPanel>
                    </Border>

                    <!-- 매뉴얼 리스트 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Manuals}"
                             SelectedItem="{Binding SelectedManual}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15,12" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11" Foreground="#888"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 우측: 매뉴얼 상세 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Border Padding="30" Visibility="{Binding HasSelectedManual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel DataContext="{Binding SelectedManual}">

                        <!-- 제목 및 카테고리 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Category}"
                                       FontSize="12" Foreground="#00A878" FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="24" FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 업무 목적 -->
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="업무 목적" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Purpose}"
                                           FontSize="14" Foreground="#555"
                                           TextWrapping="Wrap" LineHeight="24"/>
                            </StackPanel>
                        </Border>

                        <!-- 프로세스 -->
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="프로세스" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Process}"
                                           FontSize="14" Foreground="#555"
                                           TextWrapping="Wrap" LineHeight="24"/>
                            </StackPanel>
                        </Border>

                        <!-- 체크리스트 -->
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="체크리스트" FontSize="14" FontWeight="Bold" Foreground="#333"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DataContext.ChecklistProgressText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               FontSize="12" Foreground="#666"/>
                                </Grid>

                                <!-- 진행률 바 -->
                                <ProgressBar Height="8" Margin="0,0,0,15"
                                             Value="{Binding DataContext.ChecklistProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                             Maximum="100">
                                    <ProgressBar.Foreground>
                                        <SolidColorBrush Color="#00A878"/>
                                    </ProgressBar.Foreground>
                                </ProgressBar>

                                <!-- 체크리스트 항목 -->
                                <ItemsControl ItemsSource="{Binding DataContext.ChecklistItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,0,0,5"
                                                    Background="#FAFAFA" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0"
                                                              Command="{Binding DataContext.ToggleChecklistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Content}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="Foreground" Value="#999"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 히스토리 -->
                        <Border Background="White" CornerRadius="8" Padding="20"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="히스토리" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Date}"
                                                           FontSize="12" Foreground="#888"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Description}"
                                                           FontSize="13" Foreground="#555"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
