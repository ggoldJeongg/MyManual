<UserControl x:Class="MyManual.Views.CategoryMenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyManual.Views"
        MinWidth="700" MinHeight="500"
        SizeChanged="OnSizeChanged">
    <Grid Background="#F5F5F5">
        <!-- 메인 콘텐츠 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <views:Header x:Name="HeaderControl" Grid.Row="0" ActiveMenu="Category"
                          OnboardingClick="OnOnboardingButtonClick"
                          ManualClick="OnManualButtonClick"
                          OnboardingManageClick="OnOnboardingManageClick"
                          UserNameClick="OnUserNameClick"/>

            <!-- 메인 콘텐츠 (스크롤 없음 - 카드 내부에서 스크롤) -->
        <Border Grid.Row="1" Padding="20,20">
            <!-- 카테고리 그리드 (UniformGrid로 균등 배치) -->
            <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="CategoryGrid" Columns="2" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Margin="10" Padding="0"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 카테고리 헤더 (클릭 가능) -->
                                <Border Grid.Row="0" Background="#F8F8F8" Padding="15,12" CornerRadius="8,8,0,0"
                                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.CategoryClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding CategoryName}"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="14" FontWeight="Bold" Foreground="#333"/>
                                </Border>

                                <!-- 매뉴얼 목록 (내부 스크롤, 스크롤바 숨김) -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Manuals}" Margin="0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="15,10" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                                        Cursor="Hand" Background="Transparent">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ManualClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13" Foreground="#555"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        </Grid>

        <!-- 프로필 Drawer (오버레이) -->
        <views:ProfileDrawer x:Name="ProfileDrawer" LogoutRequested="OnLogoutRequested"/>
    </Grid>
</UserControl>
